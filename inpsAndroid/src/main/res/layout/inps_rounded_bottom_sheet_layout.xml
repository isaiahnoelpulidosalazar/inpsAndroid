<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inps_rounded_bottom_sheet_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/inps_rounded_bottom_sheet_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/inps_rounded_bottom_sheet_background"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/inps_rounded_bottom_sheet_handle_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/inps_rounded_bottom_sheet_handle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:alpha="0.32"
                android:background="@drawable/inps_bottom_sheet_drag_handle" />
        </FrameLayout>

        <TextView
            android:id="@+id/inps_rounded_bottom_sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="6dp"
            android:paddingEnd="24dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
            android:textColor="?android:attr/textColorPrimary"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inps_rounded_bottom_sheet_handle_area"
            tools:ignore="TextSizeCheck" />

        <TextView
            android:id="@+id/inps_rounded_bottom_sheet_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingEnd="24dp"
            android:paddingBottom="4dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inps_rounded_bottom_sheet_title" />

        <ScrollView
            android:id="@+id/inps_rounded_bottom_sheet_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:visibility="gone"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="420dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inps_rounded_bottom_sheet_subtitle" />

        <LinearLayout
            android:id="@+id/inps_rounded_bottom_sheet_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inps_rounded_bottom_sheet_scroll">

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                android:id="@+id/inps_rounded_bottom_sheet_secondary_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/inps_bottom_sheet_secondary_background"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textAllCaps="false"
                android:textColor="?android:attr/textColorPrimary"
                android:visibility="gone"
                app:inpsCornerRadius="14dp" />

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                android:id="@+id/inps_rounded_bottom_sheet_primary_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textAllCaps="false"
                android:visibility="gone"
                app:inpsCornerRadius="14dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
