<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="cornerRadius" format="dimension" />
    <attr name="isTranslucent" format="boolean" />

    <declare-styleable name="RoundedButton">
        <attr name="cornerRadius" />
    </declare-styleable>

    <declare-styleable name="RoundedEditText">
        <attr name="cornerRadius" />
    </declare-styleable>

    <declare-styleable name="RoundedConstraintLayout">
        <attr name="cornerRadius" />
        <attr name="isTranslucent" />
    </declare-styleable>

    <declare-styleable name="RoundedLinearLayout">
        <attr name="cornerRadius" />
        <attr name="isTranslucent" />
    </declare-styleable>

    <!-- New in 2.0.0 -->
    <declare-styleable name="FlippableImageView">
        <attr name="reverseBackImage" format="boolean" />
        <attr name="flipSpeed" format="enum">
            <enum name="slow" value="0" />
            <enum name="normal" value="1" />
            <enum name="fast" value="2" />
        </attr>
    </declare-styleable>
</resources>
