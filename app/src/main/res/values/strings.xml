    <!-- Overview Tab -->
    <string name="badge_getting_started">GETTING STARTED</string>
    <string name="overview_title">Modular Android Boilerplate Killer</string>
    <string name="overview_description">inpsAndroid 3.0.4 organizes utilities, drop-in UI widgets, and educational algorithm/audio modules under com.isaiahnoelpulidosalazar.inpsandroid.</string>
    <string name="overview_gradle_snippet">dependencies {\n    implementation \'com.github.isaiahnoelpulidosalazar:inpsAndroid:3.0.4\'\n}</string>
    <string name="overview_architecture_title">Package Architecture</string>
    <string name="pkg_core_label">…inpsandroid.core</string>
    <string name="pkg_core_desc">MainThread, WebRequest, EasySQL, EasyNotification, Converters, EmailDomainAllowList, StringChecks, TimeLeft</string>
    <string name="pkg_ui_label">…inpsandroid.ui</string>
    <string name="pkg_ui_desc">RoundedButton, RoundedCheckBox, RoundedEditText, RoundedLinearLayout, RoundedConstraintLayout, RoundedAlertDialog, RoundedBottomSheet, SimpleList, FlippableImageView, Fullscreen, Drawables</string>
    <string name="pkg_edu_label">…inpsandroid.edu</string>
    <string name="pkg_edu_desc">edu.sort.Sort, AreaCalculator, SoundSynthesizer</string>
    <string name="btn_explore_core">Explore Core</string>
    <string name="btn_explore_ui">Explore UI</string>
    <string name="btn_explore_edu">Explore Edu</string>
    <string name="overview_requirements_title">Requirements &amp; Theme Setup</string>
    <string name="overview_requirements_body">• minSdk 24, compileSdk 36, Java 17\n• AppCompat or Material theme defining colorPrimary, colorControlHighlight, and android:colorBackground\n• No Material dependency required by the library itself\n• Library resources &amp; attributes are prefixed with inps_ / inps / Inps</string>

    <!-- Core Tab -->
    <string name="badge_converters_validation">CONVERTERS &amp; VALIDATION</string>
    <string name="core_converters_title">Converters, EmailDomainAllowList &amp; StringChecks</string>
    <string name="core_converters_desc">Null-safe Base64 encoding, ThreadLocal date formatting, digit/symbol checks, and allow-list email validation requiring a non-empty local part.</string>
    <string name="core_output_placeholder">Run any action above to inspect live output.</string>
    <string name="core_easysql_title">EasySQL &amp; MainThread</string>
    <string name="core_easysql_desc">Parameterized SQLite wrapper with validated identifiers, transactions, and tableExists(). Methods block on disk I/O; dispatch results back to the UI with MainThread.post().</string>
    <string name="core_easysql_snippet">easySQL.inTransaction(() -&gt; {\n  easySQL.insert(\"notes\", row);\n});\nMainThread.post(() -&gt; refreshUi());</string>
    <string name="core_db_status_default">EasySQL rows synced with UI tab SimpleList.</string>
    <string name="core_webrequest_title">WebRequest &amp; TimeLeft</string>
    <string name="core_webrequest_desc">WebRequest uses a 4-thread pool and a bounded queue of 64, returning a cancellable Call handle with json(), maxResponseBytes(), and charset parsing.</string>
    <string name="core_webrequest_snippet">WebRequest.Call call = WebRequest.post(url)\n  .json(\"{\\\"hello\\\":\\\"world\\\"}\")\n  .maxResponseBytes(1024 * 1024)\n  .enqueue(callback);</string>
    <string name="core_time_output_placeholder">TimeLeft.seconds / minutes / hours ready.</string>
    <string name="badge_notifications">NOTIFICATIONS</string>
    <string name="core_notifications_title">EasyNotification Dispatcher</string>
    <string name="core_notifications_desc">Channel-aware notification builder with API 33+ POST_NOTIFICATIONS permission checks, BigText/Inbox/BigPicture styles, and safe PendingIntents.</string>
    <string name="core_notification_ready">EasyNotification ready.</string>

