    <!-- Migration Tab -->
    <string name="badge_upgrading_304">UPGRADING TO 3.0.4</string>
    <string name="migration_304_title">Migrating from 3.0.3 to 3.0.4</string>
    <string name="migration_304_desc">Version 3.0.4 prefixes all &lt;declare-styleable&gt; definitions with Inps* to satisfy resourcePrefix \'inps_\', enables Checkstyle and JaCoCo unit test coverage, and resolves Android Lint / API 36 deprecations. XML layout attributes (app:inps*) are unchanged.</string>
    <string name="migration_304_code">R.styleable.RoundedButton           -&gt; R.styleable.InpsRoundedButton\nR.styleable.RoundedEditText         -&gt; R.styleable.InpsRoundedEditText\nR.styleable.RoundedConstraintLayout -&gt; R.styleable.InpsRoundedConstraintLayout\nR.styleable.RoundedLinearLayout     -&gt; R.styleable.InpsRoundedLinearLayout\nR.styleable.RoundedCheckBox         -&gt; R.styleable.InpsRoundedCheckBox\nR.styleable.SimpleList              -&gt; R.styleable.InpsSimpleList\nR.styleable.FlippableImageView      -&gt; R.styleable.InpsFlippableImageView</string>

    <string name="badge_upgrading_300">UPGRADING TO 3.0.0</string>
    <string name="migration_300_title">Migrating from v1 &amp; v2</string>
    <string name="migration_300_desc">inpsAndroid 3.0.0 removes all deprecated v1 shims and reorganizes classes into lowercase core, ui, and edu packages under com.isaiahnoelpulidosalazar.inpsandroid.</string>
    <string name="migration_section_1_title">1. Class &amp; Package Mapping</string>
    <string name="migration_section_1_code">URLRequest / HttpRequest  -&gt; core.network.WebRequest\nEasySQL (v1) / Database   -&gt; core.database.EasySQL\nConvert / Converters      -&gt; core.convert.Converters\nCheck / EmailValidator    -&gt; core.validation.EmailDomainAllowList\nCheck / StringChecks      -&gt; core.validation.StringChecks\nActions / MainThread      -&gt; core.concurrent.MainThread\nActions / Fullscreen      -&gt; ui.Fullscreen\nDrawables                 -&gt; ui.Drawables\nSort                      -&gt; edu.sort.Sort\nCipher / ClassicalCiphers -&gt; Removed (use javax.crypto)\nMemory&lt;T&gt;                 -&gt; Removed (use ArrayList&lt;T&gt;)</string>
    <string name="migration_section_2_title">2. API &amp; Behavior Changes</string>
    <string name="migration_section_2_body">• Sort: pigeonholeSort merged into countingSort (supports negatives); timsort removed; null input throws NullPointerException.\n• AreaCalculator: removed parallelogramArea, rightTriangleArea, and squareAsRhombusArea.\n• FlippableImageView: removed toBitmap(); bitmap setters renamed to setFrontBitmap / setBackBitmap.\n• SimpleList: now extends FrameLayout wrapping a RecyclerView with ListAdapter + DiffUtil.</string>
    <string name="migration_section_3_title">3. Prefixed XML Attributes &amp; Resources</string>
    <string name="migration_section_3_code">app:cornerRadius      -&gt; app:inpsCornerRadius\napp:isTranslucent     -&gt; app:inpsIsTranslucent\napp:reverseBackImage  -&gt; app:inpsReverseBackImage\napp:flipSpeed         -&gt; app:inpsFlipSpeed\n@color/black, @color/white -&gt; Removed\ndrawables &amp; layouts   -&gt; inps_* prefix</string>

