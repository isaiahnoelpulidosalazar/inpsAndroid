        <item name="colorSurface">@color/doc_surface</item>
        <item name="colorSurfaceVariant">@color/doc_code_bg</item>
        <item name="colorPrimary">@color/doc_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/doc_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/doc_primary_ink</item>
        <item name="colorSecondary">@color/doc_accent</item>
