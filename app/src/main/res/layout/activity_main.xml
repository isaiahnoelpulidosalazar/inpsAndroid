<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top Docs Header + Tabs -->
    <LinearLayout
        android:id="@+id/docs_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/doc_surface"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/doc_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_doc_badge"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="@string/docs_version_badge"
                android:textColor="@color/doc_primary_ink"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:text="@string/docs_subtitle"
            android:textColor="@color/doc_ink_muted"
            android:textSize="13sp" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/docs_tabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/doc_surface"
            app:tabIndicatorColor="@color/doc_primary"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="18dp"
            app:tabPaddingStart="18dp"
            app:tabRippleColor="@color/doc_primary_soft"
            app:tabSelectedTextColor="@color/doc_primary"
            app:tabTextAppearance="@style/DocsTabTextAppearance"
            app:tabTextColor="@color/doc_ink_muted" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/doc_border" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/docs_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
