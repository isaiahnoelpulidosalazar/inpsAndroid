<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ui_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Rounded Views Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_doc_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_doc_badge"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="ROUNDED WIDGETS"
                android:textColor="@color/doc_primary_ink"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="RoundedButton, EditText &amp; Layouts"
                android:textColor="@color/doc_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="Shared RoundedViewHelper setup with app:inpsCornerRadius, app:inpsIsTranslucent, outline clipping on containers, and contrast-aware text color on RoundedButton."
                android:textColor="@color/doc_ink_muted"
                android:textSize="14sp" />

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="14dp"
                app:inpsCornerRadius="14dp"
                app:inpsIsTranslucent="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Live RoundedLinearLayout (inpsIsTranslucent=&quot;true&quot;)"
                    android:textColor="@color/doc_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                        android:id="@+id/btn_dialog"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:padding="10dp"
                        android:text="@string/btn_show_dialog"
                        android:textAllCaps="false"
                        app:inpsCornerRadius="12dp" />

                    <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                        android:id="@+id/btn_fullscreen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:padding="10dp"
                        android:text="@string/btn_toggle_fullscreen"
                        android:textAllCaps="false"
                        app:inpsCornerRadius="12dp" />
                </LinearLayout>

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_bottom_sheet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    android:text="@string/btn_show_bottom_sheet"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />
            </com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedLinearLayout>
        </LinearLayout>

        <!-- Modern RoundedCheckBox & Bounce Animation Toggle Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_doc_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_doc_badge_teal"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="CHECKBOXES &amp; MOTION"
                android:textColor="@color/doc_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="RoundedCheckBox &amp; Bounce Toggle"
                android:textColor="@color/doc_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="Checkable component with CARD, PILL, and MINIMAL styles plus a toggleable overshoot bounce animation (app:inpsBounceAnimation)."
                android:textColor="@color/doc_ink_muted"
                android:textSize="14sp" />

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedCheckBox
                android:id="@+id/cb_bounce_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="@string/cb_bounce_toggle"
                app:inpsBounceAnimation="true"
                app:inpsCheckStyle="pill" />

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedCheckBox
                android:id="@+id/cb_card_sample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="@string/cb_card_sample"
                app:inpsBounceAnimation="true"
                app:inpsCheckStyle="card"
                app:inpsCornerRadius="14dp" />

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedCheckBox
                android:id="@+id/cb_pill_sample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="@string/cb_pill_sample"
                app:inpsBounceAnimation="true"
                app:inpsCheckStyle="pill" />

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedCheckBox
                android:id="@+id/cb_minimal_sample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="@string/cb_minimal_sample"
                app:inpsBounceAnimation="true"
                app:inpsCheckStyle="minimal" />
        </LinearLayout>

        <!-- FlippableImageView & Drawables Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_doc_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FlippableImageView &amp; Drawables"
                android:textColor="@color/doc_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="3D card flip with .withLayer(), state persistence, setFrontBitmap/setBackBitmap, and pixel-level Drawables.equalsBitmap()."
                android:textColor="@color/doc_ink_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.FlippableImageView
                    android:id="@+id/flippable_card"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:contentDescription="@string/cd_flippable_card"
                    android:src="@drawable/ic_card_front"
                    app:inpsFlipSpeed="normal"
                    app:inpsReverseBackImage="false" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                        android:id="@+id/btn_flip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="10dp"
                        android:text="@string/btn_flip_card"
                        android:textAllCaps="false"
                        app:inpsCornerRadius="12dp" />

                    <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                        android:id="@+id/btn_cycle_speed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:padding="10dp"
                        android:text="@string/btn_cycle_speed"
                        android:textAllCaps="false"
                        app:inpsCornerRadius="12dp" />

                    <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                        android:id="@+id/btn_compare_drawables"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:padding="10dp"
                        android:text="@string/btn_compare_drawables"
                        android:textAllCaps="false"
                        app:inpsCornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/ui_drawables_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_code_block"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="Tap Flip Card or Compare Drawables."
                android:textColor="@color/doc_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- SimpleList Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_doc_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SimpleList (Checkboxes + DiffUtil)"
                android:textColor="@color/doc_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Supports classic TextView rows or RoundedCheckBox rows with bounce animation toggle. Long-press any row to remove from EasySQL."
                android:textColor="@color/doc_ink_muted"
                android:textSize="14sp" />

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedCheckBox
                android:id="@+id/cb_list_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="@string/cb_list_mode"
                app:inpsBounceAnimation="true"
                app:inpsCheckStyle="minimal" />

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.SimpleList
                android:id="@+id/simple_list"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                app:inpsBounceAnimation="true"
                app:inpsCheckStyle="card"
                app:inpsCheckboxesEnabled="true"
                app:inpsCornerRadius="12dp" />

            <TextView
                android:id="@+id/ui_list_selection_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_code_block"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:text="Checked (0): []"
                android:textColor="@color/doc_ink"
                android:textSize="12sp" />

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                android:id="@+id/btn_reset_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:padding="10dp"
                android:text="@string/btn_reset_notes"
                android:textAllCaps="false"
                app:inpsCornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
