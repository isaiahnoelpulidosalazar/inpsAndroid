<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edu_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Sort Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_doc_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_doc_badge_teal"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="ALGORITHMS"
                android:textColor="@color/doc_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Sort (edu.sort.Sort)"
                android:textColor="@color/doc_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="Comparison, non-comparison (negative-supporting countingSort with a 10M range cap), and structure sorts. Throws NullPointerException on null inputs."
                android:textColor="@color/doc_ink_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_sort_counting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Counting"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_sort_quick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Quick"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_sort_merge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Merge"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_sort_heap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Heap"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/edu_sort_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_code_block"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="Input: [42, -7, 19, 3, 25, 0, -12]"
                android:textColor="@color/doc_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- AreaCalculator Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_doc_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AreaCalculator"
                android:textColor="@color/doc_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="2D area and 3D surface-area formulas with precomputed sqrt(3) and deduplicated geometry helpers."
                android:textColor="@color/doc_ink_muted"
                android:textSize="14sp" />

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                android:id="@+id/btn_area_demo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:padding="10dp"
                android:text="@string/btn_area_demo"
                android:textAllCaps="false"
                app:inpsCornerRadius="12dp" />

            <TextView
                android:id="@+id/edu_area_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_code_block"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="Tap Run AreaCalculator to evaluate formulas."
                android:textColor="@color/doc_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- SoundSynthesizer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_doc_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SoundSynthesizer"
                android:textColor="@color/doc_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="Asynchronous MIDI-addressed piano synthesis with prepare(int...), single-thread AudioTrack playback, and low-latency mode on API 26+."
                android:textColor="@color/doc_ink_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_note_c4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="C4"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_note_e4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="E4"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_note_g4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="G4"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_note_c5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="C5"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/edu_sound_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_code_block"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="Prepared MIDI notes: 60 (C4), 64 (E4), 67 (G4), 72 (C5)"
                android:textColor="@color/doc_ink"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
