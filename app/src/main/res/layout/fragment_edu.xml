<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edu_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Sort Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_doc_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_doc_badge_teal"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="@string/badge_algorithms"
                android:textColor="@color/doc_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/edu_sort_title"
                android:textColor="@color/doc_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/edu_sort_desc"
                android:textColor="@color/doc_ink_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_sort_counting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/btn_sort_counting"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_sort_quick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/btn_sort_quick"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_sort_merge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/btn_sort_merge"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_sort_heap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/btn_sort_heap"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/edu_sort_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_code_block"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="@string/edu_sort_placeholder"
                android:textColor="@color/doc_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- AreaCalculator Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_doc_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edu_area_title"
                android:textColor="@color/doc_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/edu_area_desc"
                android:textColor="@color/doc_ink_muted"
                android:textSize="14sp" />

            <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                android:id="@+id/btn_area_demo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:padding="10dp"
                android:text="@string/btn_area_demo"
                android:textAllCaps="false"
                app:inpsCornerRadius="12dp" />

            <TextView
                android:id="@+id/edu_area_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_code_block"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="@string/edu_area_placeholder"
                android:textColor="@color/doc_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- SoundSynthesizer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_doc_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edu_sound_title"
                android:textColor="@color/doc_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/edu_sound_desc"
                android:textColor="@color/doc_ink_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_note_c4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/btn_note_c4"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_note_e4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/btn_note_e4"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_note_g4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/btn_note_g4"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />

                <com.isaiahnoelpulidosalazar.inpsandroid.ui.RoundedButton
                    android:id="@+id/btn_note_c5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/btn_note_c5"
                    android:textAllCaps="false"
                    app:inpsCornerRadius="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/edu_sound_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_code_block"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="@string/edu_sound_placeholder"
                android:textColor="@color/doc_ink"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
